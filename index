<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Làm người yêu anh nhé?</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@700&family=Nunito:wght@400;600;800&display=swap" rel="stylesheet">
    
    <style>
        body {
            margin: 0;
            padding: 0;
            width: 100vw;
            height: 100vh;
            overflow: hidden;
            font-family: 'Nunito', sans-serif;
            background: radial-gradient(ellipse at bottom, #1b2735 0%, #090a0f 100%);
            display: flex;
            justify-content: center;
            align-items: center;
            color: white;
            touch-action: manipulation;
        }

        #stars-container, #falling-stars-container, #hearts-container {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 0;
            pointer-events: none;
        }

        .twinkling-star {
            position: absolute;
            background-color: #fff;
            border-radius: 50%;
            animation: twinkle var(--duration) ease-in-out infinite alternate;
            animation-delay: var(--delay);
        }

        @keyframes twinkle {
            0% { opacity: 0.1; transform: scale(0.5); box-shadow: 0 0 0px rgba(255,255,255,0); }
            100% { opacity: 1; transform: scale(1.5); box-shadow: 0 0 8px 2px rgba(255,255,255,0.8); }
        }

        .falling-star {
            position: absolute;
            background-color: #fff;
            border-radius: 50%;
            box-shadow: 0 0 10px 2px rgba(255, 255, 255, 0.6), 0 0 20px 4px rgba(200, 230, 255, 0.4);
            animation: fall var(--duration) linear infinite;
            animation-delay: var(--delay);
            opacity: 0;
        }

        @keyframes fall {
            0% { 
                transform: translateY(-5vh) translateX(0); 
                opacity: 0; 
            }
            10% { 
                opacity: var(--max-opacity); 
            }
            90% { 
                opacity: var(--max-opacity); 
            }
            100% { 
                transform: translateY(105vh) translateX(var(--sway)); 
                opacity: 0; 
            }
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(15px);
            -webkit-backdrop-filter: blur(15px);
            border: 1px solid rgba(255, 255, 255, 0.15);
            box-shadow: 0 8px 32px 0 rgba(0, 0, 0, 0.5);
            z-index: 10;
            transition: all 0.5s ease;
        }

        .romantic-text {
            font-family: 'Dancing Script', cursive;
            background: linear-gradient(to right, #ff758c 0%, #ff7eb3 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            text-shadow: 0px 4px 15px rgba(255, 117, 140, 0.3);
            line-height: 1.3;
        }

        .btn-yes {
            background: linear-gradient(135deg, #ff0844 0%, #ffb199 100%);
            transition: transform 0.2s, box-shadow 0.2s;
        }
        
        .btn-yes:hover {
            transform: scale(1.05);
            box-shadow: 0 0 20px rgba(255, 8, 68, 0.6);
        }

        .btn-no {
            background: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.3);
            backdrop-filter: blur(5px);
            transition: background 0.3s;
            cursor: pointer;
        }

        .heart {
            position: absolute;
            top: -50px;
            font-size: 2rem;
            color: #ff4d6d;
            animation: heart-fall var(--duration) ease-in-out infinite;
            z-index: 5;
            text-shadow: 0 0 15px rgba(255, 77, 109, 0.6);
        }

        @keyframes heart-fall {
            0% {
                transform: translateY(0) scale(0.8) rotate(0deg);
                opacity: 1;
            }
            100% {
                transform: translateY(110vh) scale(1.5) rotate(var(--rotation));
                opacity: 0;
            }
        }
    </style>
</head>
<body>

    <div id="stars-container"></div>
    <div id="falling-stars-container"></div>
    <div id="hearts-container"></div>

    <div class="glass-card rounded-3xl p-8 md:p-12 max-w-lg w-[90%] text-center flex flex-col items-center justify-center relative">
        <div id="content-wrapper" class="w-full">
            <h1 id="main-message" class="romantic-text text-5xl md:text-6xl mb-8 py-2">
                Làm người yêu anh nhé? ❤️
            </h1>
            
            <div id="btn-container" class="flex flex-col sm:flex-row gap-6 justify-center items-center mt-6 h-[140px] sm:h-16 w-full relative">
                <button id="yes-btn" class="btn-yes text-white font-bold py-3 px-10 rounded-full text-xl shadow-lg w-48 cursor-pointer z-20">
                    Đồng ý
                </button>
                <button id="no-btn" class="btn-no text-white font-semibold py-3 px-10 rounded-full text-xl w-48 z-20">
                    Không
                </button>
            </div>
        </div>
    </div>

    <script>
        const starsContainer = document.getElementById('stars-container');
        const fallingStarsContainer = document.getElementById('falling-stars-container');
        
        // Generate static twinkling stars (sao lấp lánh)
        function createTwinklingStars() {
            const numStars = 150;
            for (let i = 0; i < numStars; i++) {
                const star = document.createElement('div');
                star.classList.add('twinkling-star');
                
                star.style.left = `${Math.random() * 100}%`;
                star.style.top = `${Math.random() * 100}%`;
                
                const size = Math.random() * 2.5 + 0.5;
                star.style.width = `${size}px`;
                star.style.height = `${size}px`;
                
                star.style.setProperty('--duration', `${Math.random() * 3 + 1.5}s`);
                star.style.setProperty('--delay', `${Math.random() * 5}s`);
                
                starsContainer.appendChild(star);
            }
        }

        // Generate slow falling stars (sao rơi từ từ)
        function createFallingStars() {
            const numFallingStars = 40;
            for (let i = 0; i < numFallingStars; i++) {
                const star = document.createElement('div');
                star.classList.add('falling-star');
                
                // Random horizontal start position
                star.style.left = `${Math.random() * 100}%`;
                
                // Random size
                const size = Math.random() * 3 + 1.5;
                star.style.width = `${size}px`;
                star.style.height = `${size}px`;
                
                // Extremely slow fall duration (10 to 25 seconds)
                star.style.setProperty('--duration', `${Math.random() * 15 + 10}s`);
                star.style.setProperty('--delay', `-${Math.random() * 20}s`); // Negative delay so some are already on screen
                
                // Slight horizontal sway as it falls (-50px to 50px)
                const sway = (Math.random() - 0.5) * 100;
                star.style.setProperty('--sway', `${sway}px`);
                
                // Random maximum opacity for glowing effect
                star.style.setProperty('--max-opacity', `${Math.random() * 0.6 + 0.4}`);
                
                fallingStarsContainer.appendChild(star);
            }
        }

        createTwinklingStars();
        createFallingStars();

        const noBtn = document.getElementById('no-btn');
        const yesBtn = document.getElementById('yes-btn');
        const mainMessage = document.getElementById('main-message');
        const btnContainer = document.getElementById('btn-container');
        const heartsContainer = document.getElementById('hearts-container');

        // Logic to make "Không" dodge the cursor
        const dodgeButton = () => {
            noBtn.style.position = 'fixed';
            
            // Padding to keep it away from extreme edges
            const padding = 20;
            const btnWidth = noBtn.offsetWidth;
            const btnHeight = noBtn.offsetHeight;
            
            const maxX = window.innerWidth - btnWidth - padding;
            const maxY = window.innerHeight - btnHeight - padding;
            
            const randomX = Math.max(padding, Math.floor(Math.random() * maxX));
            const randomY = Math.max(padding, Math.floor(Math.random() * maxY));
            
            noBtn.style.left = `${randomX}px`;
            noBtn.style.top = `${randomY}px`;
        };

        noBtn.addEventListener('mouseover', dodgeButton);
        noBtn.addEventListener('touchstart', (e) => {
            e.preventDefault(); 
            dodgeButton();
        });

        // Generate slow-falling hearts on Yes
        function startFallingHearts() {
            setInterval(() => {
                const heart = document.createElement('div');
                heart.classList.add('heart');
                heart.innerHTML = '❤️';
                
                heart.style.left = `${Math.random() * 100}%`;
                
                // Slow fall for hearts (5 to 10 seconds)
                heart.style.setProperty('--duration', `${Math.random() * 5 + 5}s`);
                
                // Random rotation while falling
                const rotation = (Math.random() - 0.5) * 360;
                heart.style.setProperty('--rotation', `${rotation}deg`);
                
                const scale = Math.random() * 0.8 + 0.5;
                heart.style.transform = `scale(${scale})`;
                
                heartsContainer.appendChild(heart);
                
                // Clean up DOM
                setTimeout(() => {
                    heart.remove();
                }, 10000);
            }, 250); 
        }

        // Click "Đồng ý" event
        yesBtn.addEventListener('click', () => {
            mainMessage.innerHTML = 'Anh biết mà!<br/>Yêu em nhiều lắmmm ❤️';
            mainMessage.classList.add('scale-110', 'transition', 'duration-700');
            
            btnContainer.style.display = 'none';
            if (noBtn.style.position === 'fixed') {
                noBtn.style.display = 'none';
            }
            
            startFallingHearts();
        });
    </script>
</body>
</html>
